# AERA Pong haptics: the LineageOS Pong vibrator HAL, built from source
# (device/nothing/Pong/aidl/vibrator). It drives /sys/class/leds/aw_vibrator.
# Started by init.recovery.qcom.rc once the kernel modules are loaded.
service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service.nt.pong
    class hal
    user root
    group root input
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0
